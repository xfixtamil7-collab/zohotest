# Server Configuration
PORT=3000

# Mock Mode Configuration (Set to true to run without external API credentials)
MOCK_ALL=true

# Database Configuration (SQLite by default, change to postgresql:// for production)
DATABASE_URL="file:./dev.db"

# Redis URL (Used for BullMQ, falls back to in-memory queue if unavailable/unconfigured)
REDIS_URL="redis://localhost:6379"

# OpenAI API Settings
OPENAI_API_KEY="your_openai_api_key_here"

# Zoho Inventory API Settings
# Zoho OAuth Credentials
ZOHO_CLIENT_ID="your_zoho_client_id_here"
ZOHO_CLIENT_SECRET="your_zoho_client_secret_here"
ZOHO_REFRESH_TOKEN="your_zoho_refresh_token_here"
ZOHO_ORG_ID="your_zoho_organization_id_here"
ZOHO_REGION="in" # Options: in, com, eu, com.cn, com.au

# WhatsApp Cloud API Settings
WHATSAPP_TOKEN="your_meta_whatsapp_access_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id_here"
WHATSAPP_VERIFY_TOKEN="your_whatsapp_webhook_verify_token_here"
PUBLIC_URL="your_railway_app_url_here"
